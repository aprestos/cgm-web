    "luxon": "^3.7.2",
    "pinia": "^4.0.2",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1",
    "vue": "^3.5.40",
    "vue-chartjs": "^5.3.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-filepond": "^8.0.0",
    "vue-i18n": "^11.4.6",
    "vue-multiselect": "^3.5.0",
    "vue-qrcode-reader": "^5.7.3",
